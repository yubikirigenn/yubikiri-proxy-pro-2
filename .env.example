PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# PCエージェント連携（Render公開時のみ）。8文字以上の共有シークレットを
# サーバー側とPC側（src/agent.js）で同じ値にする。
# AGENT_SECRET=change-me-to-a-long-random-string
# RENDER_URL=https://your-service.onrender.com
# AGENT_CONCURRENCY=6

# ホスト名モード(既定オフ)。サーバー側で /hostname リレーを有効化する場合のみ 1。
# 未設定なら既存のパスモードだけ動き、挙動は一切変わらない。
# HOSTNAME_MODE=1
# PC側のローカル中継(src/hostname-agent.js)の設定。RENDER_URL/AGENT_SECRET は
# 上のエージェントと同じ値を使い、別途 npm run hostname-agent で起動する。
# LOCAL_PROXY_PORT=8899
# HOSTNAME_PROXY_HOSTS=auctions.yahoo.co.jp,note.com,poe.com,www.google.com
# HOSTNAME_CA_DIR=   (既定: ~/.yubikiri-hostname)
